<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 (API 31) 起，云备份与换机转移由 dataExtractionRules 控制，
  优先级高于 allowBackup。本 App 存储用户的 API Key（Keystore 加密）与
  私人聊天记录，全部排除出备份域，避免被整机备份/换机转移带走到别的设备。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
